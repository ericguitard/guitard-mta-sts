# MIME types and cache policy for mta-sts.guitard.ca

# The direct error document may be cached for ten minutes. Unknown addresses still retain their genuine 404 response status.
/404.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: max-age=600
  Content-Security-Policy: default-src 'none'; script-src https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self'; style-src 'self'; img-src https://assets.guitard.ca; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

# CSS uses a query-string version and currently has a four-hour browser TTL.
/css/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: max-age=14400
  Content-Security-Policy: default-src 'none'; script-src https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self'; style-src 'self'; img-src https://assets.guitard.ca; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow

# MTA-STS clients fetch this protocol-critical policy directly over HTTPS.
/.well-known/mta-sts.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self'; style-src 'self'; img-src https://assets.guitard.ca; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow

# robots.txt is stable and currently has a four-hour browser TTL.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: max-age=14400
  Content-Security-Policy: default-src 'none'; script-src https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self'; style-src 'self'; img-src https://assets.guitard.ca; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow
